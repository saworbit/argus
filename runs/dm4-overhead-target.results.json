{
  "schema": 1,
  "protocol": "docs/specs/2026-11-17-overhead-target-protocol.md",
  "what": "A grounded re-plan for a routed bot whose steering point stands out of step and jump reach overhead, behind solid, for 0.3 s: the dry-land sibling of the displacement guard's water clause.",
  "arms": {
    "ctl": "819F9AB90BC77DF84A34491601430DF2",
    "cand_v1": "457F046853D12C0A3702E434E8A399F6",
    "cand_v2": "1FF4C96DCD4311E4ABE1D361ADAAD94F",
    "cand_v3": "5CA1A55855C65977ADEE4BD7B60C7667"
  },
  "candidate_v1_diff": "--- src/argus.qc\n+++ src/argus.qc\n@@ -213,2 +213,4 @@\n .float  ar_wetdwell;            // time we were last NOT afloat\n+.float  ar_overhead;            // since when the steering node has stood overhead behind solid\n+.float  ar_overheadseen;        // the last frame it did\n float ar_opm_ears;              // OPM slice B ladder switch: hearing\n@@ -1903,2 +1905,34 @@\n     return AR_JUMPVEL * AR_JUMPVEL / (2 * Argus_Gravity ());\n+};\n+\n+// TRUE when a grounded routed bot's steering node has stood out of reach\n+// overhead, behind solid, for 0.3 s. The 340u displacement guard measures\n+// horizontal distance and the vertical guard below it covers water alone, so\n+// a bot that ran off a legal drop under its node, or was knocked into a pit\n+// beneath it, kept steering at it: on dm4 one walkway node 128u over a room\n+// held bots sliding along the wall under it for seconds\n+// (runs/lab-wallmix-mix.results.json). Above step plus jump reach and behind\n+// solid it is displacement. Every typed hop is exempt: a lift, a train, a\n+// rocket jump, a swim exit and a door all legitimately target a node above.\n+float(vector tp) Argus_OverheadTarget =\n+{\n+    if (!(self.flags & FL_ONGROUND)\n+        || tp_z <= self.origin_z + 18 + Argus_JumpApex ()\n+        || self.ar_hoplift || self.ar_hoptrain || self.ar_hopjump\n+        || self.ar_hoprj || self.ar_hopswim || self.ar_hopdoor\n+        || self.ar_sprintstate || self.ar_liftwait)\n+    {\n+        self.ar_overhead = 0;\n+        return FALSE;\n+    }\n+    traceline (self.origin, tp, TRUE, self);\n+    if (trace_fraction == 1)\n+    {\n+        self.ar_overhead = 0;\n+        return FALSE;\n+    }\n+    if (!self.ar_overhead || time > self.ar_overheadseen + 0.1)\n+        self.ar_overhead = time;\n+    self.ar_overheadseen = time;\n+    return (time >= self.ar_overhead + 0.3);\n };\n@@ -10912,2 +10946,10 @@\n             }\n+            else if (Argus_OverheadTarget (tp))\n+            {\n+                // displaced vertically, on dry ground: re-plan\n+                self.ar_overhead = 0;\n+                self.ar_node = world;\n+                self.ar_pending = 1;\n+                self.ar_mode = 0;\n+            }\n             else if (vlen (to) < 48",
  "candidate_v2_diff": "--- src/argus.qc\n+++ src/argus.qc\n@@ -213,2 +213,4 @@\n .float  ar_wetdwell;            // time we were last NOT afloat\n+.float  ar_overhead;            // since when the steering node has stood overhead behind solid\n+.float  ar_overheadseen;        // the last frame it did\n float ar_opm_ears;              // OPM slice B ladder switch: hearing\n@@ -1903,2 +1905,38 @@\n     return AR_JUMPVEL * AR_JUMPVEL / (2 * Argus_Gravity ());\n+};\n+\n+// TRUE when a grounded routed bot's steering node has stood out of reach\n+// overhead, behind solid, for 0.3 s. The 340u displacement guard measures\n+// horizontal distance and the vertical guard below it covers water alone, so\n+// a bot that ran off a legal drop under its node, or was knocked into a pit\n+// beneath it, kept steering at it: on dm4 one walkway node 128u over a room\n+// held bots sliding along the wall under it for seconds\n+// (runs/lab-wallmix-mix.results.json). Above step plus jump reach and behind\n+// solid it is displacement. A lift, a train, a rocket jump, a swim exit and\n+// a door legitimately target a node above and are exempt. A jump is not:\n+// navgen lands a jump at most 40u above its takeoff, below this reach, so a\n+// jump hop whose target stands this far overhead has already failed. dm4's\n+// walkway jump from node 111 to 115 crosses the open top of the room below,\n+// and bots that miss the run-up land in the room still on that hop.\n+float(vector tp) Argus_OverheadTarget =\n+{\n+    if (!(self.flags & FL_ONGROUND)\n+        || tp_z <= self.origin_z + 18 + Argus_JumpApex ()\n+        || self.ar_hoplift || self.ar_hoptrain\n+        || self.ar_hoprj || self.ar_hopswim || self.ar_hopdoor\n+        || self.ar_sprintstate || self.ar_liftwait)\n+    {\n+        self.ar_overhead = 0;\n+        return FALSE;\n+    }\n+    traceline (self.origin, tp, TRUE, self);\n+    if (trace_fraction == 1)\n+    {\n+        self.ar_overhead = 0;\n+        return FALSE;\n+    }\n+    if (!self.ar_overhead || time > self.ar_overheadseen + 0.1)\n+        self.ar_overhead = time;\n+    self.ar_overheadseen = time;\n+    return (time >= self.ar_overhead + 0.3);\n };\n@@ -10912,2 +10950,13 @@\n             }\n+            else if (Argus_OverheadTarget (tp))\n+            {\n+                // displaced vertically, on dry ground: re-plan, and\n+                // drop the jump hop it may have failed\n+                self.ar_overhead = 0;\n+                self.ar_hopjump = 0;\n+                self.ar_hopspeed = 0;\n+                self.ar_node = world;\n+                self.ar_pending = 1;\n+                self.ar_mode = 0;\n+            }\n             else if (vlen (to) < 48",
