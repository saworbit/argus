/* argus_nav_dispatch.qc - hand-maintained map dispatcher for Argus nav.
   The per-map data files are generated by tools/argus_navgen.py with
   --no-dispatcher; add a branch here (and a line in progs.src) when
   compiling nav for a new map. Maps without a branch degrade to
   line-of-sight seeking. */

void() Argus_Nav_Spawn =
{
    if (mapname == "lqdm2")
        Argus_Nav_Spawn_lqdm2 ();
    else if (mapname == "dm2")
        Argus_Nav_Spawn_dm2 ();
    else if (mapname == "dm3")
        Argus_Nav_Spawn_dm3 ();
    else if (mapname == "dm4")
        Argus_Nav_Spawn_dm4 ();
    else if (mapname == "dm6")
        Argus_Nav_Spawn_dm6 ();
    else if (mapname == "e1m1")
        Argus_Nav_Spawn_e1m1 ();
    else if (mapname == "e1m2")
        Argus_Nav_Spawn_e1m2 ();
    else if (mapname == "e1m5")
        Argus_Nav_Spawn_e1m5 ();
    else if (mapname == "e1m6")
        Argus_Nav_Spawn_e1m6 ();
    else if (mapname == "e1m7")
        Argus_Nav_Spawn_e1m7 ();
    else if (mapname == "e1m8")
        Argus_Nav_Spawn_e1m8 ();
};
