# Shell scripts must always use LF line endings
*.sh text eol=lf

# Windows batch files must always use CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets - do not attempt line ending conversion or text diffing
*.dat binary
*.pak binary
*.bsp binary
*.mdl binary
*.png binary
*.dem binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
