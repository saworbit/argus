# Store detected text as LF; platform-specific checkout rules follow below
* text=auto eol=lf

# Source code files
*.qc text
*.src text
*.rs text
*.py text
*.c text
*.h text

# Configuration and documentation
*.md text
*.txt text
*.json text
*.toml text
*.yml text
*.yaml text
*.cfg text

# Study receipts hash the original console bytes, including CRLF.
