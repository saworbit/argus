# Store detected text as LF; platform-specific checkout rules follow below
* text=auto eol=lf

# Source code files
*.qc text
*.src text
*.rs text
*.py text
*.c text
*.h text

# Configuration and documentation
*.md text
*.txt text
*.json text
*.toml text
*.yml text
*.yaml text
*.cfg text

# Study receipts hash the original console bytes, including CRLF.
runs/broad_*.log -text !eol -whitespace
runs/freeze_*.log -text !eol -whitespace
runs/mover_forecast_v1_*.log -text !eol -whitespace
runs/camera_chase_v1_*.log -text !eol -whitespace
runs/mover_handoff_v2_*.log -text !eol -whitespace
runs/startup_skill_v1_*.log -text !eol -whitespace
runs/stall_ownership_v1_*.log -text !eol -whitespace
runs/stall-ownership-v1.source.patch -whitespace
runs/motion_observer_v2_*.log -text !eol -whitespace
runs/ally_barrel_v1_*.log -text !eol -whitespace
runs/ally-barrel-v1.source.patch -whitespace
runs/motion-observer-v2.mutation.txt -text !eol -whitespace
runs/motion-observer-v2.reference.json -text !eol -whitespace
docs/mover-exit-prototype.patch -whitespace

# Shell scripts must always use LF line endings
*.sh text eol=lf

# Windows batch files must always use CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets - do not attempt line ending conversion or text diffing
*.dat binary
*.pak binary
*.bsp binary
*.mdl binary
*.png binary
*.dem binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
