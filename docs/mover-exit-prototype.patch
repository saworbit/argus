+// A lift's exit node may be near our height before the slab has docked.
+// Height proximity alone must not release a carried body. At the dock,
+// the route's landing can also be behind a lip rather than straight ahead;
+// use the normal floor referee to find an exit without replacing the route.
+vector(vector target) Argus_MoverExitTarget =
+{
+    local entity mover;
+    local vector to;
+    local float yaw;
+    mover = self.groundentity;
+    if (!self.ar_hoplift || !(self.flags & FL_ONGROUND)
+        || mover.classname != "plat")
+        return target;
+    if (mover.state == STATE_UP || mover.state == STATE_DOWN)
+    {
+        self.ar_liftwait = 1;
+        self.velocity_x = 0; self.velocity_y = 0;
+        return target;
+    }
+    if (mover.state != STATE_TOP || fabs (target_z - self.origin_z) > 48)
+        return target;
+    to = target - self.origin; to_z = 0;
+    if (vlen (to) < 8) return target;
+    yaw = vectoyaw (to);
+    if (!Argus_MoveHazard (yaw, 48)) return target;
+    yaw = Argus_HazardSteer (yaw, 48);
+    if (Argus_MoveHazard (yaw, 48)) return target;
+    makevectors ('0 0 0' + yaw * '0 1 0');
+    return self.origin + v_forward * 96;
+};
