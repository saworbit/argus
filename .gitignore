# Argus .gitignore - written before any git init, so licensed id data
# can never reach a repository (a hard project rule; see AGENTS.md).

# id/Steam licensed data: machine-local only, never commit
engine/id1/
maps_local/
engine/argus/progs/player.mdl

# the whole lab engine is a machine-local convenience install
engine/*.exe
engine/*.pak
engine/*.dll
engine/argus316/
engine/omicron/
# scratch mod dirs: lab runs need a -game dir under engine/, and a
# git add -A has twice swept one into a commit. Only argus/ ships.
engine/*/
!engine/argus/
engine/qconsole.log

# id-derived coloured model staging (regenerate from LibreQuake for
# a shippable build; see tools/mdl_skins.py header)
*.mdl

# build outputs (root only: src/lq1/ is QC source and must commit)
/lq1/

# setup_rig.sh droppings: a second QC tree, the fteqcc checkout, the
# extracted game data and the rig's own quake dir. Only compile.log,
# match.log and *.png were covered, and /lq1/ is root anchored, so a
# git add -A after a rig run staged about 100 MB of LibreQuake data.
tools/argus-src/
tools/fteqw/
tools/quake/
tools/lq-lite/
tools/lq-server/
tools/lq-*.zip
tools/lq1/
__pycache__/
tools/argus_mcp/target*/
tools/argus_mcp/install/
backups/
tools/win/

# generated lab maps (tools/lab_mapgen.py, docs/lab-scenarios.md): the
# request, the generated .map and the manifest are tracked; build outputs
# are regenerated by lab_request, and the pinned compiler stays local
tools/external/
labmaps/*/*.bsp
labmaps/*/*.wad
labmaps/*/*.prt
labmaps/*/*.lit
labmaps/*/*.pts
labmaps/*/*.log
labmaps/*/mill.json

# engine/session droppings
**/qconsole.log
**/config.cfg
engine/history.txt
compile.log
match.log
*.png

# keep the telemetry record: runs/*.log are plain-text project
# history and safe to commit (runs/*.png are regenerable plots)
!runs/*.log

# curated README media and the brand rasters are the PNG exceptions
!docs/media/*.png
!docs/brand/*.png

# brand generator dependencies (npm install in tools/brand)
tools/brand/node_modules/

# Omicron capture: the WHOLE capture stays machine-local (Shane,
# 2026-08-20) - sealed zips, models, decompile blobs, author
# papers, and the research notes too. Nothing under it commits.
scratch_omicron/
tools/decompiled_omicron/

# assistant, agent, LLM artefacts, and IDE configuration
**/.claude/
**/.claude
**/CLAUDE.md
**/claude.md
**/CLAUDE*.md
**/claude*.md
**/*.claude

**/.codex/
**/.codex
**/CODEX.md
**/codex.md
**/CODEX*.md
**/codex*.md
**/*.codex

**/.gemini/
**/.gemini
**/GEMINI.md
**/gemini.md
**/GEMINI*.md
**/gemini*.md
**/*.gemini

**/.agents/
**/.agents
**/AGENTS.md
**/agents.md
**/AGENTS*.md
**/agents*.md
**/*.agent.md
**/*.agents.md

**/.cursor/
**/.cursorrules
**/.cursorignore
**/.cursorindexingignore

**/.windsurf/
**/.windsurfrules
**/.windsurfrules*

**/.vscode/
**/.idea/

**/.mcp.json
!**/.mcp.json.example
**/.mcp/

**/.aider*
**/.cline/
