**/copilot-instructions.md
**/COPILOT.md
**/copilot.md

**/CHATGPT.md
**/chatgpt.md
**/OPENAI.md
**/openai.md

**/*.prompt
**/*.prompt.md
**/*.prompts.md
**/llms.txt
**/llms-full.txt
**/llm_cache/
**/prompts/

history.txt
engine/argus/maps/
runs/demos/
runs/lab/
runs/benchmark_*
runs/cycle_*_snapshot/
runs/soak.stop
runs/probe_inject_test*
runs/.lab_session.json
engine/argus/*.dem
runs/probe_links_run*
runs/probe_netclient_test*
runs/probe_soak_state.json
/runs/scratch_*.dat

# generated nav overlays for the engine pointfile command
*.pts

# generated by tools/argus_edicts.py
engine/argus/edump.cfg

# superpowers SDD scratch (ledger, briefs, review packages)
.superpowers/

# Generated local review assets; keep the reusable tools/ HTML template.
/reviews/blind-perception-*/

# Frozen local study tapes. Hashes are retained in runs/local-study-tapes.json.
/runs/bhv[0-2]_*.log
/runs/perc[1-3]_*.log
/runs/hi[1-2]_*.log
/runs/blindv1_*.log
/runs/muzzle1_*.log
# Lab scenario ladders (docs/lab-scenarios.md): full-rate ARGMOT tapes of 3 to
# 5 MB each; each ladder's results.json in runs/ records every tape's map,
# size and SHA-256.
/runs/labvc_*.log
/runs/labvc2_*.log
/runs/labvc3_*.log
/runs/labvc4_*.log
/runs/dm4et_*.log
/runs/labvc5_*.log
/runs/dm4fl_*.log
/runs/labdm_*.log
/runs/dm4elbow_*.log
/runs/dm4bt_*.log
