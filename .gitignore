/runs/labvc3_*.nav.json
/runs/labvc4_*.nav.json
/runs/dm4et_*.nav.json
/runs/labvc5_*.nav.json
/runs/dm4fl_*.nav.json
/runs/labdm_*.nav.json
/runs/dm4elbow_*.nav.json
/runs/dm4bt_*.nav.json

# Portable project rules are reviewed; local agent notes stay ignored.
!/AGENTS.md

# operating system and editor droppings
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# Python tooling caches and environments
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.coverage
htmlcov/

# secrets and credentials never belong in the tree
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
