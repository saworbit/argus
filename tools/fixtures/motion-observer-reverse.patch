-        dprint (" from "); dprint (ftos (origin_yaw));
-        dprint (" to "); dprint (ftos (requested)); dprint ("\n");
-        self.ar_motionbaseyaw = requested; self.ar_motionbasetime = time;
-    }
-    return requested;
-};
