[
  {"name": "line comment", "source": "a // c\r\nb", "expected": "a\nb"},
  {"name": "block comment between tokens", "source": "a/* c */b", "expected": "a b"},
  {"name": "multiline block overrides a space", "source": "a \t/* c\n d */  b", "expected": "a\nb"},
  {"name": "layout on directive lines", "source": " \t#define X 1\r\n\n\f  foo\u000b  bar\t", "expected": "#define X 1\nfoo bar"},
