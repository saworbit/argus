  {"name": "escaped double quotes and backslash", "source": "s = \"say \\\"hi\\\" // path \\\\x\";", "expected": "s = \"say \\\"hi\\\" // path \\\\x\";"},
  {"name": "vector literal layout and escape", "source": "v  = '0  0 1';  p = 'a\\'b';", "expected": "v = '0  0 1'; p = 'a\\'b';"},
  {"name": "unterminated comment at EOF", "source": "a /* trailing\n", "expected": "a"},
  {"name": "Latin-1 literal bytes", "source": "s = \"caf\u00e9 \u00a0\";", "expected": "s = \"caf\u00e9 \u00a0\";"}
