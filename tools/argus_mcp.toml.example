# Copy to tools/argus_mcp.toml or point ARGUS_MCP_CONFIG at a copy.
# Environment variables with the same names override these values.
# Operator guide: tools/argus_mcp/README.md.
# Humans: argus-mcp gui  (localhost wizard; uses these same keys).
# If ARGUS_ROOT is unset, the server walks parents for
# game/argus/autoexec.cfg and fills fteqcc/engine/python when those
# files exist in the usual lab layout. Env always wins over this
# file and over discovery.
# Required for compile / match / navgen. see / brief / compare need
# only ARGUS_ROOT.

ARGUS_ROOT = "C:/argus"
ARGUS_FTEQCC = "C:/argus/tools/win/fteqcc/fteqw-2026-07-13/fteqcc64.exe"
ARGUS_ENGINE = "C:/argus/engine/quakespasm.exe"
ARGUS_BASEDIR = "C:/argus/engine"
ARGUS_PYTHON = "C:/Windows/py.exe"

# Optional. Defaults are paths under ARGUS_ROOT.
# ARGUS_GAME = "argus"
# ARGUS_SRC = "C:/argus/src"
# ARGUS_RUNS = "C:/argus/runs"
# ARGUS_PROGS = "C:/argus/lq1/progs.dat"
# ARGUS_MAPS = "C:/argus/maps_local"
